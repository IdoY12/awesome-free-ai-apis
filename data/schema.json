{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "awesome-free-ai-apis dataset",
  "type": "object",
  "required": ["meta", "providers", "graveyard"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "version", "last_full_review"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "last_full_review": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/definitions/provider" }
    },
    "graveyard": {
      "type": "array",
      "items": { "$ref": "#/definitions/graveyardEntry" }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "what"],
        "properties": {
          "id": { "type": "string" },
          "what": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "tri": { "enum": ["yes", "no", "opt-out", "unclear"] },
    "source": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "accessed": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "id": { "type": ["string", "null"] },
        "context": { "type": ["integer", "null"] },
        "max_output": { "type": ["integer", "null"] },
        "modality": { "type": ["string", "null"] },
        "capabilities": {
          "type": "object",
          "properties": {
            "tool_calling": { "type": ["boolean", "null"] },
            "json_mode": { "type": ["boolean", "null"] },
            "vision": { "type": ["boolean", "null"] },
            "reasoning": { "type": ["boolean", "null"] }
          }
        },
        "rate_limit": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "name", "category", "website", "free_tier", "policy", "sources", "last_verified", "confidence", "probe"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "category": {
          "enum": [
            "text_llm", "image_generation", "stt", "tts", "embeddings", "reranking",
            "vector_db", "web_search", "ocr_document", "moderation", "translation", "vision_other"
          ]
        },
        "website": { "type": "string", "pattern": "^https?://\\S+$" },
        "api_key_url": { "type": ["string", "null"], "pattern": "^https?://\\S+$" },
        "api_key_note": { "type": ["string", "null"] },
        "base_url": { "type": ["string", "null"] },
        "base_url_note": { "type": ["string", "null"] },
        "openai_compatible": { "type": ["boolean", "string", "null"] },
        "country": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "hosting_regions": { "type": ["string", "null"] },
        "region": { "type": "string", "maxLength": 40 },
        "stale": { "type": "boolean" },
        "confidence": { "enum": ["verified", "partial", "community"] },
        "free_tier": {
          "type": "object",
          "required": ["summary", "headline"],
          "properties": {
            "summary": { "type": ["string", "null"] },
            "headline": { "type": "string", "maxLength": 160 },
            "limits": { "type": ["string", "null"] },
            "credit_card_required": { "type": ["boolean", "null"] },
            "api_key_required": { "type": ["boolean", "null"] },
            "identity_verification_required": { "type": ["boolean", "string", "null"] }
          }
        },
        "policy": {
          "type": "object",
          "required": ["trains_on_your_data", "commercial_use", "gdpr_dpa"],
          "properties": {
            "trains_on_your_data": { "$ref": "#/definitions/tri" },
            "training_note": { "type": ["string", "null"] },
            "commercial_use": { "$ref": "#/definitions/tri" },
            "commercial_note": { "type": ["string", "null"] },
            "gdpr_dpa": { "$ref": "#/definitions/tri" },
            "gdpr_note": { "type": ["string", "null"] },
            "data_retention": { "type": ["string", "null"] }
          }
        },
        "models": { "type": "array", "items": { "$ref": "#/definitions/model" } },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string" }, "notes": { "type": ["string", "null"] } }
          }
        },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
        "notes": { "type": ["string", "null"] },
        "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "probe": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["openai_models", "openai_chat", "http", "docs"] },
            "url": { "type": "string" },
            "auth": { "type": "string", "pattern": "^(none|env:[A-Z0-9_]+)$" },
            "model": { "type": "string" },
            "count_filter": { "type": "string" },
            "docs_url": { "type": ["string", "null"], "pattern": "^https?://\\S+$" }
          }
        }
      }
    },
    "graveyardEntry": {
      "type": "object",
      "required": ["id", "name", "status", "reason"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": ["string", "null"] },
        "status": { "enum": ["retired", "trial_only", "never_free"] },
        "reason": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/definitions/source" } },
        "noted": { "type": "string" }
      }
    }
  }
}
